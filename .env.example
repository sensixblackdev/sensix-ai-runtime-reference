# Exposto apenas pelo gateway. Gere uma chave longa e exclusiva.
SENSIX_GATEWAY_API_KEY=replace-with-a-long-random-secret

# Necessário somente para modelos Hugging Face gated. Nunca envie isto ao modelo.
HF_TOKEN=

# URLs internas separadas por vírgula. O gateway faz health check e menor-carga.
VLLM_UPSTREAMS=http://vllm:8000
SENSIX_MODEL_ID=gpt-oss-120b
